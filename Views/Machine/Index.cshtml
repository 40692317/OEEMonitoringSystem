@model IEnumerable<OEEMonitoringSystem.Models.Machine>
@{
    ViewData["Title"] = "Machines";
}

<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="mb-0">
                    <i class="bi bi-tools"></i> Machines
                </h1>
                <p class="text-muted mb-0">Factory equipment management</p>
            </div>
            <div>
                @if (User.IsInRole("Admin"))
                {
                    <a asp-controller="Admin" asp-action="Machines" class="btn btn-primary">
                        <i class="bi bi-gear"></i> Manage Machines
                    </a>
                }
            </div>
        </div>
    </div>
</div>

@if (Model.Any())
{
    <div class="row">
        @foreach (var machine in Model)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100">
                    <div class="card-header">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5 class="card-title mb-0">@machine.Name</h5>
                            <span class="badge @(machine.IsActive ? "bg-success" : "bg-secondary")">
                                @(machine.IsActive ? "Active" : "Inactive")
                            </span>
                        </div>
                        <small class="text-white-50">@machine.Location</small>
                    </div>
                    <div class="card-body">
                        <dl class="row small">
                            <dt class="col-6">Cycle Time</dt>
                            <dd class="col-6">@machine.TargetCycleTime s</dd>
                            <dt class="col-6">Created</dt>
                            <dd class="col-6">@machine.CreatedAt.ToString("MMM dd")</dd>
                        </dl>
                    </div>
                    <div class="card-footer">
                        <div class="btn-group w-100" role="group">
                            <a asp-action="Events" asp-route-id="@machine.Id" class="btn btn-sm btn-outline-info">
                                <i class="bi bi-clock-history"></i> Events
                            </a>
                            <a asp-controller="Dashboard" asp-action="MachineDetail" asp-route-id="@machine.Id" class="btn btn-sm btn-outline-success">
                                <i class="bi bi-eye"></i> View
                            </a>
                            <a asp-action="Simulate" asp-route-id="@machine.Id" class="btn btn-sm btn-outline-warning">
                                <i class="bi bi-play-circle"></i> Simulate
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="text-center py-5">
        <i class="bi bi-tools" style="font-size: 3rem; color: #ced4da;"></i>
        <h3 class="mt-3">No Machines Assigned</h3>
        <p class="text-muted">Contact your administrator to assign machines to your account.</p>
    </div>
}