@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}
<div class="text-center mt-5">
    <h1 class="text-danger">Error</h1>
    <p class="text-muted">An error occurred while processing your request.</p>
@if (Model.ShowRequestId)
{
        <p>
            <strong>Request ID:</strong> <code>@Model.RequestId</code>
        </p>
}
    <p class="text-muted">Please try again later or contact support if the issue persists.</p>
    <a href="@Url.Action("Index", "Home")" class="btn btn-primary">Back to Home</a>


@if (Model.ShowRequestId)
{
        <p class="mt-3">
            <small class="text-muted">If you need to report this issue, please include the Request ID above.</small>
        </p>
}


