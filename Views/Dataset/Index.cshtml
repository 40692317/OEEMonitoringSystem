@model IEnumerable<OEEMonitoringSystem.Models.ViewModel.MachineFeatureRow>?
@{
    ViewData["Title"] = "Model";
}

<div class="row">
    <div class="col-12">
        <h1 class="mb-0">
            <i class="bi bi-cpu"></i> Model
        </h1>
        <p class="text-muted mb-0">Train and evaluate ML models for OEE prediction and machine state classification.</p>
    </div>
</div>

<div class="row mt-4">
    <div class="col-12">
        <div class="card">
            <div class="card-body text-center py-5">
                <a asp-action="ML" class="btn btn-primary btn-lg px-5"><i class="bi bi-cpu"></i> Train ML models</a>
                <p class="text-muted small mt-2 mb-0">One click trains both Regression and Classification models. Results and algorithm comparison appear on the ML training page.</p>
            </div>
        </div>
    </div>
</div>

