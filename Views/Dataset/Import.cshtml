@{
    ViewData["Title"] = "Import Dataset";
}

<div class="row">
    <div class="col-12">
        <h1 class="mb-0">
            <i class="bi bi-upload"></i> Import Dataset
        </h1>
        <p class="text-muted mb-0">Import from OEE_Dataset.xlsx and OeeReport .xlsx (Phase 1)</p>
    </div>
</div>

<div class="row mt-4">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">OEE_Dataset.xlsx</h5>
            </div>
            <div class="card-body">
                <p class="small text-muted">Expected columns: Machine, Date &amp; Time, Availability %, Performance %, Quality %, OEE %. Event-level files: Machine, Date/Time, EventType, Duration, Quantity.</p>
                <form asp-action="ImportOEEDataset" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label">Select file</label>
                        <input type="file" name="file" class="form-control" accept=".xlsx" />
                    </div>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-upload"></i> Import OEE Dataset</button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">OeeReport .xlsx</h5>
            </div>
            <div class="card-body">
                <p class="small text-muted">OEE report. Expected columns: <strong>Machine</strong>, <strong>Date &amp; Time</strong>, <strong>Availability %</strong>, <strong>Performance %</strong>, <strong>Quality %</strong>, <strong>OEE %</strong>. Product, Planned, Actual Units, Downtime, Stop/Start/Idle etc. are optional.</p>
                <form asp-action="ImportOeeReport" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label">Select file</label>
                        <input type="file" name="file" class="form-control" accept=".xlsx" />
                    </div>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-upload"></i> Import OeeReport</button>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-12">
        <div class="card border-primary">
            <div class="card-header bg-primary text-white">
                <h5 class="card-title mb-0"><i class="bi bi-collection"></i> Combined dataset (for ML)</h5>
            </div>
            <div class="card-body">
                <p class="text-muted mb-3">Upload both files at once. Data is merged into one dataset used for ML training.</p>
                <form asp-action="ImportBoth" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div class="row">
                        <div class="col-md-5 mb-3">
                            <label class="form-label">OEE_Dataset.xlsx</label>
                            <input type="file" name="oeeDataset" class="form-control" accept=".xlsx" />
                        </div>
                        <div class="col-md-5 mb-3">
                            <label class="form-label">OeeReport.xlsx</label>
                            <input type="file" name="oeeReport" class="form-control" accept=".xlsx" />
                        </div>
                        <div class="col-md-2 mb-3 d-flex align-items-end">
                            <button type="submit" class="btn btn-primary w-100"><i class="bi bi-upload"></i> Import both</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-database"></i> Back to Dataset / Features</a>
    <a asp-action="ML" class="btn btn-outline-primary ms-2"><i class="bi bi-cpu"></i> Train ML models</a>
</div>
