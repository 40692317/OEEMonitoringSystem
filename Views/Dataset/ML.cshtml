@using System.Text.Json
@{
    ViewData["Title"] = "Train ML Models";

    string? regGbt = TempData["RegDefault"] as string;
    string? regForest = TempData["RegForest"] as string;
    string? regSdca = TempData["RegSdca"] as string;
    string? clsGbt = TempData["ClsDefault"] as string;
    string? clsForest = TempData["ClsForest"] as string;
    string? clsSdca = TempData["ClsSdca"] as string;
    string? cmGbtJson = TempData["CmGbt"] as string;
    string? cmForestJson = TempData["CmForest"] as string;
    string? cmSdcaJson = TempData["CmSdca"] as string;

    bool hasComparison = !string.IsNullOrEmpty(regGbt) && !string.IsNullOrEmpty(regForest) && !string.IsNullOrEmpty(regSdca);

    string[] ParseRow(string? raw) => raw?.Split('|') ?? Array.Empty<string>();

    var rGbt = ParseRow(regGbt);
    var rForest = ParseRow(regForest);
    var rSdca = ParseRow(regSdca);
    var cGbt = ParseRow(clsGbt);
    var cForest = ParseRow(clsForest);
    var cSdca = ParseRow(clsSdca);

    string FindRegWinner(string[][] rows)
    {
        double best = double.MinValue;
        int idx = 0;
        for (int i = 0; i < rows.Length; i++)
        {
            if (rows[i].Length >= 4 && double.TryParse(rows[i][3], out var r2) && r2 > best)
            { best = r2; idx = i; }
        }
        return rows[idx].Length > 0 ? rows[idx][0] : "";
    }

    string FindClsWinner(string[][] rows)
    {
        double best = double.MinValue;
        int idx = 0;
        for (int i = 0; i < rows.Length; i++)
        {
            if (rows[i].Length >= 2 && double.TryParse(rows[i][1], out var acc) && acc > best)
            { best = acc; idx = i; }
        }
        return rows[idx].Length > 0 ? rows[idx][0] : "";
    }

    var regRows = new[] { rGbt, rForest, rSdca };
    var clsRows = new[] { cGbt, cForest, cSdca };
    var regWinner = hasComparison ? FindRegWinner(regRows) : "";
    var clsWinner = hasComparison ? FindClsWinner(clsRows) : "";
}

<div class="row">
    <div class="col-12">
        <h1 class="mb-0">
            <i class="bi bi-cpu"></i> Train &amp; Compare ML Models
        </h1>
        <p class="text-muted mb-0">
            Trains three algorithms side-by-side for both Regression and Classification
            so you can compare results in one click.
        </p>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success mt-3" role="alert"><i class="bi bi-check-circle"></i> @TempData["Success"]</div>
}
@if (TempData["Warning"] != null)
{
    <div class="alert alert-warning mt-3" role="alert"><i class="bi bi-exclamation-triangle"></i> @TempData["Warning"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger mt-3" role="alert"><i class="bi bi-x-circle"></i> @TempData["Error"]</div>
}

<!-- ============================================================ -->
<!-- Train Button                                                  -->
<!-- ============================================================ -->
<div class="row mt-4">
    <div class="col-12">
        <div class="card border-primary">
            <div class="card-body text-center py-5">
                <form asp-action="TrainAllModels" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-primary btn-lg px-5">
                        <i class="bi bi-cpu"></i> Train &amp; Compare All Algorithms
                    </button>
                </form>
                <p class="text-muted small mt-3 mb-0">
                    Trains <strong>Regression</strong> (predict OEE %) + <strong>Classification</strong> (Normal / Warning / Critical)<br />
                    using <strong>FastTree</strong>, <strong>Random Forest</strong>, and <strong>SDCA (Linear / Logistic)</strong>.<br />
                    Uses 80/20 train-test split. Best algorithm per task is saved automatically.
                </p>
            </div>
        </div>
    </div>
</div>

<!-- ============================================================ -->
<!-- ML Architecture Diagram                                       -->
<!-- ============================================================ -->
<div class="card mt-4">
    <div class="card-header bg-dark text-white">
        <h5 class="card-title mb-0"><i class="bi bi-diagram-3"></i> ML Pipeline Architecture</h5>
    </div>
    <div class="card-body p-4">
        <div class="d-flex flex-column align-items-center">
            <!-- Input Layer -->
            <div class="border rounded p-3 text-center w-100" style="max-width:700px; background:#e7f1ff;">
                <h6 class="fw-bold mb-2"><i class="bi bi-box-arrow-in-down"></i> Input Layer (Features)</h6>
                <div class="d-flex flex-wrap justify-content-center gap-2">
                    <span class="badge bg-primary">Availability</span>
                    <span class="badge bg-primary">Performance</span>
                    <span class="badge bg-primary">Actual Units</span>
                    <span class="badge bg-primary">Packs</span>
                    <span class="badge bg-primary">Stop Time</span>
                    <span class="badge bg-primary">Start Time</span>
                    <span class="badge bg-primary">Processing</span>
                    <span class="badge bg-primary">Printing</span>
                    <span class="badge bg-primary">Idle</span>
                </div>
            </div>
            <div class="text-center my-1"><i class="bi bi-arrow-down fs-4 text-secondary"></i></div>

            <!-- Pre-processing Layer -->
            <div class="border rounded p-3 text-center w-100" style="max-width:700px; background:#fff3cd;">
                <h6 class="fw-bold mb-2"><i class="bi bi-gear"></i> Data Pre-processing Layer</h6>
                <span class="badge bg-warning text-dark me-1">Feature Concatenation</span>
                <span class="badge bg-warning text-dark me-1">Min-Max Normalization</span>
                <span class="badge bg-warning text-dark">Label Encoding (Classification)</span>
            </div>
            <div class="text-center my-1"><i class="bi bi-arrow-down fs-4 text-secondary"></i></div>

            <!-- Model Selection Layer -->
            <div class="border rounded p-3 text-center w-100" style="max-width:700px; background:#d1e7dd;">
                <h6 class="fw-bold mb-2"><i class="bi bi-ui-checks-grid"></i> Model Selection Layer</h6>
                <div class="row g-2 justify-content-center">
                    <div class="col-auto"><span class="badge bg-success px-3 py-2">FastTree</span></div>
                    <div class="col-auto"><span class="badge bg-success px-3 py-2">Random Forest</span></div>
                    <div class="col-auto"><span class="badge bg-success px-3 py-2">SDCA (Linear / Logistic)</span></div>
                </div>
            </div>
            <div class="text-center my-1"><i class="bi bi-arrow-down fs-4 text-secondary"></i></div>

            <!-- Training Layer -->
            <div class="border rounded p-3 text-center w-100" style="max-width:700px; background:#cfe2ff;">
                <h6 class="fw-bold mb-2"><i class="bi bi-lightning"></i> Training Layer</h6>
                <span class="badge bg-info text-dark me-1">80/20 Train-Test Split</span>
                <span class="badge bg-info text-dark me-1">Model Fitting</span>
                <span class="badge bg-info text-dark">Model Saved (.zip)</span>
            </div>
            <div class="text-center my-1"><i class="bi bi-arrow-down fs-4 text-secondary"></i></div>

            <!-- Testing / Evaluation Layer -->
            <div class="border rounded p-3 text-center w-100" style="max-width:700px; background:#f8d7da;">
                <h6 class="fw-bold mb-2"><i class="bi bi-clipboard-check"></i> Testing &amp; Evaluation Layer</h6>
                <div class="mb-1">
                    <strong>Regression:</strong>
                    <span class="badge bg-danger me-1">RMSE</span>
                    <span class="badge bg-danger me-1">MAE</span>
                    <span class="badge bg-danger">R&sup2;</span>
                </div>
                <div>
                    <strong>Classification:</strong>
                    <span class="badge bg-danger me-1">Accuracy</span>
                    <span class="badge bg-danger me-1">LogLoss</span>
                    <span class="badge bg-danger">Confusion Matrix</span>
                </div>
            </div>
        </div>
    </div>
</div>

@if (hasComparison)
{
    <!-- ============================================================ -->
    <!-- Regression Comparison Table                                   -->
    <!-- ============================================================ -->
    <div class="card mt-4">
        <div class="card-header bg-dark text-white">
            <h5 class="card-title mb-0"><i class="bi bi-bar-chart"></i> Regression Comparison (predicts OEE %)</h5>
        </div>
        <div class="card-body p-0">
            <table class="table table-hover table-bordered mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Algorithm</th>
                        <th>RMSE <small class="text-muted">(lower=better)</small></th>
                        <th>MAE <small class="text-muted">(lower=better)</small></th>
                        <th>R&sup2; <small class="text-muted">(closer to 1=better)</small></th>
                        <th>Train Rows</th>
                        <th>Test Rows</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in regRows)
                    {
                        var name = row.Length > 0 ? row[0] : "-";
                        var isWinner = name == regWinner;
                        <tr class="@(isWinner ? "table-success" : "")">
                            <td>
                                <strong>@name</strong>
                                @if (isWinner) { <span class="badge bg-success ms-1">Best</span> }
                            </td>
                            <td>@(row.Length > 1 ? row[1] : "-")</td>
                            <td>@(row.Length > 2 ? row[2] : "-")</td>
                            <td>@(row.Length > 3 ? row[3] : "-")</td>
                            <td>@(row.Length > 4 ? row[4] : "-")</td>
                            <td>@(row.Length > 5 ? row[5] : "-")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- ============================================================ -->
    <!-- Regression Performance Bar Chart                               -->
    <!-- ============================================================ -->
    <div class="card mt-4">
        <div class="card-header bg-dark text-white">
            <h5 class="card-title mb-0"><i class="bi bi-bar-chart-line"></i> Regression Performance Comparison</h5>
        </div>
        <div class="card-body">
            <canvas id="regBarChart" height="200"></canvas>
        </div>
    </div>

    <!-- ============================================================ -->
    <!-- Classification Comparison Table                               -->
    <!-- ============================================================ -->
    <div class="card mt-4">
        <div class="card-header bg-dark text-white">
            <h5 class="card-title mb-0"><i class="bi bi-bar-chart"></i> Classification Comparison (Normal / Warning / Critical)</h5>
        </div>
        <div class="card-body p-0">
            <table class="table table-hover table-bordered mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Algorithm</th>
                        <th>Macro Accuracy <small class="text-muted">(closer to 1=better)</small></th>
                        <th>LogLoss <small class="text-muted">(lower=better)</small></th>
                        <th>Train Rows</th>
                        <th>Test Rows</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in clsRows)
                    {
                        var name = row.Length > 0 ? row[0] : "-";
                        var isWinner = name == clsWinner;
                        <tr class="@(isWinner ? "table-success" : "")">
                            <td>
                                <strong>@name</strong>
                                @if (isWinner) { <span class="badge bg-success ms-1">Best</span> }
                            </td>
                            <td>@(row.Length > 1 ? row[1] : "-")</td>
                            <td>@(row.Length > 2 ? row[2] : "-")</td>
                            <td>@(row.Length > 3 ? row[3] : "-")</td>
                            <td>@(row.Length > 4 ? row[4] : "-")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- ============================================================ -->
    <!-- Confusion Matrices                                            -->
    <!-- ============================================================ -->
    <div class="card mt-4">
        <div class="card-header bg-dark text-white">
            <h5 class="card-title mb-0"><i class="bi bi-grid-3x3"></i> Confusion Matrices (Classification)</h5>
        </div>
        <div class="card-body">
            <p class="text-muted small mb-3">
                Rows = <strong>Actual</strong> class, Columns = <strong>Predicted</strong> class.
                <span style="background:#d4edda; padding:2px 8px; border-radius:4px;">Green diagonal</span> = correct predictions.
                <span style="background:#f8d7da; padding:2px 8px; border-radius:4px;">Red off-diagonal</span> = misclassifications.
            </p>
            <div class="row g-4">
                @{
                    var cmEntries = new[] {
                        (json: cmGbtJson, name: cGbt.Length > 0 ? cGbt[0] : "FastTree"),
                        (json: cmForestJson, name: cForest.Length > 0 ? cForest[0] : "Random Forest"),
                        (json: cmSdcaJson, name: cSdca.Length > 0 ? cSdca[0] : "SDCA")
                    };
                }
                @foreach (var entry in cmEntries)
                {
                    <div class="col-md-4">
                        <h6 class="text-center fw-bold">@entry.name</h6>
                        @if (!string.IsNullOrEmpty(entry.json))
                        {
                            var cmData = JsonSerializer.Deserialize<JsonElement>(entry.json);
                            var labels = cmData.GetProperty("labels");
                            var counts = cmData.GetProperty("counts");
                            var labelList = new List<string>();
                            foreach (var lbl in labels.EnumerateArray())
                            {
                                labelList.Add(lbl.GetString() ?? "?");
                            }
                            <table class="table table-sm table-bordered text-center mb-0">
                                <thead>
                                    <tr>
                                        <th class="bg-light"></th>
                                        @foreach (var lbl in labelList)
                                        {
                                            <th class="bg-light"><small>Pred: @lbl</small></th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        int rowIdx = 0;
                                    }
                                    @foreach (var rowEl in counts.EnumerateArray())
                                    {
                                        <tr>
                                            <td class="bg-light fw-bold"><small>@(rowIdx < labelList.Count ? labelList[rowIdx] : "?")</small></td>
                                            @{
                                                int colIdx = 0;
                                            }
                                            @foreach (var cell in rowEl.EnumerateArray())
                                            {
                                                var val = cell.GetDouble();
                                                var isDiag = rowIdx == colIdx;
                                                var bgColor = isDiag ? "#d4edda" : (val > 0 ? "#f8d7da" : "");
                                                <td style="background:@bgColor; font-weight:@(isDiag ? "bold" : "normal");">
                                                    @val.ToString("F0")
                                                </td>
                                                colIdx++;
                                            }
                                        </tr>
                                        rowIdx++;
                                    }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            <p class="text-muted text-center">No data</p>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="alert alert-info mt-3">
        <i class="bi bi-info-circle"></i>
        The <span class="badge bg-success">Best</span> row is the winner for each task.
        After comparison, the system automatically saves the <strong>best algorithm per task</strong> — active for live predictions.
    </div>
}

<div class="mt-3">
    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left"></i> Back to Dashboard
    </a>
</div>

@if (hasComparison)
{
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
    (function() {
        var labels = [
            '@Html.Raw(rGbt.Length > 0 ? rGbt[0] : "GBT")',
            '@Html.Raw(rForest.Length > 0 ? rForest[0] : "Random Forest")',
            '@Html.Raw(rSdca.Length > 0 ? rSdca[0] : "SDCA")'
        ];
        var rmse = [
            parseFloat('@(rGbt.Length > 1 ? rGbt[1] : "0")'),
            parseFloat('@(rForest.Length > 1 ? rForest[1] : "0")'),
            parseFloat('@(rSdca.Length > 1 ? rSdca[1] : "0")')
        ];
        var mae = [
            parseFloat('@(rGbt.Length > 2 ? rGbt[2] : "0")'),
            parseFloat('@(rForest.Length > 2 ? rForest[2] : "0")'),
            parseFloat('@(rSdca.Length > 2 ? rSdca[2] : "0")')
        ];
        var r2 = [
            parseFloat('@(rGbt.Length > 3 ? rGbt[3] : "0")'),
            parseFloat('@(rForest.Length > 3 ? rForest[3] : "0")'),
            parseFloat('@(rSdca.Length > 3 ? rSdca[3] : "0")')
        ];

        new Chart(document.getElementById('regBarChart'), {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [
                    {
                        label: 'RMSE (lower = better)',
                        data: rmse,
                        backgroundColor: 'rgba(220, 53, 69, 0.7)',
                        borderColor: 'rgba(220, 53, 69, 1)',
                        borderWidth: 1
                    },
                    {
                        label: 'MAE (lower = better)',
                        data: mae,
                        backgroundColor: 'rgba(255, 193, 7, 0.7)',
                        borderColor: 'rgba(255, 193, 7, 1)',
                        borderWidth: 1
                    },
                    {
                        label: 'R\u00B2 (closer to 1 = better)',
                        data: r2,
                        backgroundColor: 'rgba(25, 135, 84, 0.7)',
                        borderColor: 'rgba(25, 135, 84, 1)',
                        borderWidth: 1
                    }
                ]
            },
            options: {
                indexAxis: 'y',
                responsive: true,
                plugins: {
                    title: {
                        display: true,
                        text: 'Regression Metrics by Algorithm',
                        font: { size: 16 }
                    },
                    legend: {
                        position: 'bottom'
                    }
                },
                scales: {
                    x: {
                        beginAtZero: true,
                        title: { display: true, text: 'Metric Value' }
                    },
                    y: {
                        title: { display: true, text: 'Algorithm' }
                    }
                }
            }
        });
    })();
    </script>
}
