@model OEEMonitoringSystem.Models.ApplicationUser
@{
    ViewData["Title"] = "Edit User";
    var isCurrentUser = User.Identity?.Name == Model.UserName;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Edit User</h1>
    <a asp-action="UserDetails" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Back to Details
    </a>
</div>

<form asp-action="EditUser" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="row">
        <div class="col-md-6">
            <div class="card mb-3">
                <div class="card-header">
                    <h5 class="card-title mb-0">User Information</h5>
                </div>
                <div class="card-body">
                    <div class="form-group mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="UserName" class="form-label"></label>
                        <input asp-for="UserName" class="form-control" />
                        <span asp-validation-for="UserName" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="FirstName" class="form-label"></label>
                        <input asp-for="FirstName" class="form-control" />
                        <span asp-validation-for="FirstName" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="LastName" class="form-label"></label>
                        <input asp-for="LastName" class="form-control" />
                        <span asp-validation-for="LastName" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card mb-3">
                <div class="card-header">
                    <h5 class="card-title mb-0">Roles & Status</h5>
                </div>
                <div class="card-body">
                    <div class="form-group form-check mb-3">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label">Active Account</label>
                        <div class="form-text">Inactive users cannot log in.</div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Assign Roles</label>
                        @{
                            var allRoles = ViewBag.AllRoles as IEnumerable<string> ?? new List<string>();
                            var userRoles = ViewBag.UserRoles as IList<string> ?? new List<string>();
                            foreach (var roleName in allRoles)
                            {
                                var roleId = "role" + roleName.Replace(" ", "");
                                var isChecked = userRoles.Contains(roleName);
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="selectedRoles"
                                           value="@roleName" id="@roleId" @(isChecked ? "checked" : "") />
                                    <label class="form-check-label" for="@roleId">@roleName</label>
                                </div>
                            }
                        }
                        @if (!allRoles.Any())
                        {
                            <p class="text-muted small mb-0">No roles defined. <a asp-action="ManageRoles">Manage roles</a>.</p>
                        }
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Quick Actions</h5>
                </div>
                <div class="card-body">
                    <a asp-action="ResetPassword" asp-route-id="@Model.Id" class="btn btn-dark w-100 mb-2">
                        <i class="bi bi-key"></i> Reset Password
                    </a>
                    @if (!isCurrentUser)
                    {
                        <form asp-action="ToggleUserStatus" asp-route-id="@Model.Id" method="post"
                              onsubmit="return confirm('@(Model.IsActive ? "Revoke access?" : "Restore access?")')">
                            @Html.AntiForgeryToken()
                            @if (Model.IsActive)
                            {
                                <button type="submit" class="btn btn-outline-secondary w-100">
                                    <i class="bi bi-person-slash"></i> Revoke Access
                                </button>
                            }
                            else
                            {
                                <button type="submit" class="btn btn-success w-100">
                                    <i class="bi bi-person-check"></i> Restore Access
                                </button>
                            }
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="mt-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-check-lg"></i> Save Changes
        </button>
        <a asp-action="ManageUsers" class="btn btn-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
