@model OEEMonitoringSystem.Models.Machine
@{
    ViewData["Title"] = "Edit Machine";
}

<h2>Edit Machine</h2>

<form asp-action="EditMachine" method="post">
    <input type="hidden" asp-for="Id" />

    <!-- Important: Don't include CreatedAt in form unless needed -->
    <!-- <input type="hidden" asp-for="CreatedAt" /> -->

    <div class="form-group">
        <label asp-for="Name" class="control-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Location" class="control-label"></label>
        <input asp-for="Location" class="form-control" />
        <span asp-validation-for="Location" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="TargetCycleTime" class="control-label"></label>
        <input asp-for="TargetCycleTime" class="form-control" />
        <span asp-validation-for="TargetCycleTime" class="text-danger"></span>
    </div>

    <div class="form-group form-check">
        <input asp-for="IsActive" class="form-check-input" />
        <label asp-for="IsActive" class="form-check-label"></label>
    </div>

    <!-- User Assignment Section -->
    @if (ViewBag.AllUsers != null && ViewBag.AllUsers is IEnumerable<OEEMonitoringSystem.Models.ApplicationUser>)
    {
        <div class="card mt-4">
            <div class="card-header">
                <h5 class="card-title mb-0">User Assignments</h5>
            </div>
            <div class="card-body">
                <div class="form-group">
                    <label class="control-label">Assign to Users</label>
                    <div class="row">
                        @foreach (var user in (ViewBag.AllUsers as IEnumerable<OEEMonitoringSystem.Models.ApplicationUser>).Where(u => u.IsActive))
                        {
                            <div class="col-md-6">
                                <div class="form-check">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           name="selectedUserIds"
                                           value="@user.Id"
                                           @(ViewBag.AssignedUsers != null && ((IEnumerable<OEEMonitoringSystem.Models.ApplicationUser>)ViewBag.AssignedUsers).Any(u => u.Id == user.Id) ? "checked" : "") />
                                    <label class="form-check-label">@user.FirstName @user.LastName (@user.Email)</label>
                                </div>
                            </div>
                        }

                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle"></i> No users available for assignment.
        </div>
    }

    <div class="form-group mt-3">
        <input type="submit" value="Save" class="btn btn-primary" />
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
