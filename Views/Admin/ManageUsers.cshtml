@model IEnumerable<OEEMonitoringSystem.Models.ApplicationUser>
@{
    ViewData["Title"] = "Manage Users";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Manage Users</h1>
    <a asp-action="CreateUser" class="btn btn-success">
        <i class="bi bi-plus-circle"></i> Create New User
    </a>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>User</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    var userRoles = ViewBag.UserRoles as Dictionary<string, IList<string>>;
                    var roles = userRoles != null && userRoles.ContainsKey(user.Id) ? userRoles[user.Id] : new List<string>();
                    var isCurrentUser = User.Identity?.Name == user.UserName;

                    <tr class="@(!user.IsActive ? "table-secondary" : "")">
                        <td>
                            <div>
                                <strong>@user.FirstName @user.LastName</strong>
                                @if (isCurrentUser)
                                {
                                    <span class="badge bg-info ms-1">You</span>
                                }
                            </div>
                            <small class="text-muted">@user.Email</small>
                        </td>
                        <td>
                            @foreach (var role in roles)
                            {
                                var badgeClass = role == "Admin" ? "bg-danger" : "bg-primary";
                                <span class="badge @badgeClass">@role</span>
                            }
                            @if (!roles.Any())
                            {
                                <span class="text-muted">No role</span>
                            }
                        </td>
                        <td>
                            @if (user.IsActive)
                            {
                                <span class="badge bg-success"><i class="bi bi-check-circle"></i> Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary"><i class="bi bi-x-circle"></i> Revoked</span>
                            }
                        </td>
                        <td>
                            <small>@user.CreatedAt.ToString("dd MMM yyyy")</small>
                        </td>
                        <td class="text-end">
                            <div class="btn-group" role="group">
                                <a asp-action="UserDetails" asp-route-id="@user.Id"
                                   class="btn btn-sm btn-outline-info" title="View Details">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="EditUser" asp-route-id="@user.Id"
                                   class="btn btn-sm btn-outline-warning" title="Edit User">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="ResetPassword" asp-route-id="@user.Id"
                                   class="btn btn-sm btn-outline-dark" title="Reset Password">
                                    <i class="bi bi-key"></i>
                                </a>
                                @if (!isCurrentUser)
                                {
                                    <form asp-action="ToggleUserStatus" asp-route-id="@user.Id" method="post"
                                          class="d-inline"
                                          onsubmit="return confirm('@(user.IsActive ? "Revoke access for " + user.Email + "?" : "Restore access for " + user.Email + "?")')">
                                        @Html.AntiForgeryToken()
                                        @if (user.IsActive)
                                        {
                                            <button type="submit" class="btn btn-sm btn-outline-secondary" title="Revoke Access">
                                                <i class="bi bi-person-slash"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-sm btn-outline-success" title="Restore Access">
                                                <i class="bi bi-person-check"></i>
                                            </button>
                                        }
                                    </form>
                                    <a asp-action="DeleteUser" asp-route-id="@user.Id"
                                       class="btn btn-sm btn-outline-danger" title="Delete User">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">Back to Admin Panel</a>
</div>
