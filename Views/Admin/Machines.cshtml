@model OEEMonitoringSystem.Models.ViewModels.MachineListViewModel
@{
    ViewData["Title"] = "Manage Machines";
}


<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="mb-0">
                    <i class="bi bi-tools"></i> Manage Machines
                </h1>
                <p class="text-muted mb-0">Create and configure factory equipment</p>
            </div>
            <div>
                <a asp-action="CreateMachine" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i> Create New Machine
                </a>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body">
        @if (Model.Machines.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Location</th>
                            <th>Target Cycle Time</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Machines)
                        {
                            <tr>
                                <td>
                                    <strong>@item.Name</strong>
                                    <div class="small text-muted">ID: @item.Id</div>
                                </td>
                                <td>@item.Location</td>
                                <td>@item.TargetCycleTime seconds</td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success">
                                            <i class="bi bi-check-circle"></i> Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            <i class="bi bi-x-circle"></i> Inactive
                                        </span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a asp-action="EditMachine" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-pencil"></i> Edit
                                        </a>
                                        <button type="button" class="btn btn-sm btn-outline-info" onclick="assignMachine(@item.Id)">
                                            <i class="bi bi-person-plus"></i> Assign
                                        </button>
                                        <form asp-action="DeleteMachine" asp-route-id="@item.Id" method="post" style="display:inline;">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Are you sure you want to delete this machine? This action cannot be undone.')">
                                                <i class="bi bi-trash"></i> Delete
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-tools" style="font-size: 3rem; color: #ced4da;"></i>
                <h3 class="mt-3">No Machines Found</h3>
                <p class="text-muted">Get started by creating your first machine.</p>
                <a asp-action="CreateMachine" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i> Create Machine
                </a>
            </div>
        }
    </div>
</div>

<!-- Assign Machine Modal -->
<div class="modal fade" id="assignModal" tabindex="-1" aria-labelledby="assignModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="assignModalLabel">
                    <i class="bi bi-person-plus"></i> Assign Machine to User
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="assignForm" method="post" asp-controller="Admin" asp-action="AssignMachineToUser">
                    <input type="hidden" id="machineId" name="machineId" />
                    <div class="mb-3">
                        <label for="userId" class="form-label">Select User</label>
                        <select class="form-select" id="userId" name="userId" required>
                            <option value="">Choose a user...</option>
                            @if (ViewBag.Users != null)
                            {
                                @foreach (var user in (IEnumerable<OEEMonitoringSystem.Models.ApplicationUser>)ViewBag.Users)
                                {
                                    <option value="@user.Id">@user.Email (@user.FirstName @user.LastName)</option>
                                }
                            }
                        </select>
                        <div class="form-text">Select the operator to assign this machine to.</div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x"></i> Cancel
                </button>
                <button type="button" class="btn btn-primary" onclick="submitAssignForm()">
                    <i class="bi bi-check"></i> Assign Machine
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function assignMachine(machineId) {
            document.getElementById('machineId').value = machineId;
            var assignModal = new bootstrap.Modal(document.getElementById('assignModal'));
            assignModal.show();
        }

        function submitAssignForm() {
            document.getElementById('assignForm').submit();
        }
    </script>
}