@model Microsoft.AspNetCore.Identity.IdentityRole
@{
    ViewData["Title"] = "Edit Role";
}

<h1><i class="bi bi-pencil"></i> Edit Role</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="EditRole" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <div class="mb-3">
                <label for="name" class="form-label">Role Name</label>
                <input type="text" name="name" id="name" class="form-control" required value="@Model.Name" />
            </div>
            <div class="mt-3">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check"></i> Save</button>
                <a asp-action="ManageRoles" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
