@{
    ViewData["Title"] = "Create Role";
}

<h1><i class="bi bi-plus-circle"></i> Create Role</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="CreateRole" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label for="name" class="form-label">Role Name</label>
                <input type="text" name="name" id="name" class="form-control" required placeholder="e.g. Operator" />
            </div>
            <div class="mt-3">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check"></i> Create</button>
                <a asp-action="ManageRoles" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
