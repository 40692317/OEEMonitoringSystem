@model IEnumerable<Microsoft.AspNetCore.Identity.IdentityRole>
@{
    ViewData["Title"] = "Manage Roles";
    var roleUserCount = ViewBag.RoleUserCount as Dictionary<string, int> ?? new Dictionary<string, int>();
}

<h1><i class="bi bi-person-badge"></i> Manage Roles</h1>

<p>
    <a asp-action="CreateRole" class="btn btn-success">
        <i class="bi bi-plus-circle"></i> Create New Role
    </a>
    <a asp-action="Index" class="btn btn-secondary ms-2"><i class="bi bi-arrow-left"></i> Admin Panel</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Role Name</th>
            <th>Users in Role</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var role in Model)
        {
            var count = roleUserCount.ContainsKey(role.Id) ? roleUserCount[role.Id] : 0;
            <tr>
                <td>@role.Name</td>
                <td>@count</td>
                <td>
                    <div class="btn-group" role="group">
                        <a asp-action="EditRole" asp-route-id="@role.Id" class="btn btn-sm btn-outline-warning">
                            <i class="bi bi-pencil"></i> Edit
                        </a>
                        <a asp-action="DeleteRole" asp-route-id="@role.Id" class="btn btn-sm btn-outline-danger">
                            <i class="bi bi-trash"></i> Delete
                        </a>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <p class="text-muted">No roles yet. Create a role to get started.</p>
}
