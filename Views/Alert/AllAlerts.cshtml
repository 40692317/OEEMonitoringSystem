@model OEEMonitoringSystem.Models.ViewModels.AlertViewModel
@{
    ViewData["Title"] = "All Alerts";
}

<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="mb-0">
                    <i class="bi bi-list"></i> All Alerts
                </h1>
                <p class="text-muted mb-0">Complete alert history organized by date</p>
            </div>
            <div>
                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Back to Dashboard
                </a>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">
                    <i class="bi bi-graph-up"></i> Alert Statistics
                </h5>
            </div>
            <div class="card-body">
                <div class="row text-center">
                    <div class="col-md-4 mb-3">
                        <div class="display-4 text-primary">@Model.TotalAlerts</div>
                        <div class="text-muted">Total Alerts</div>
                    </div>
                    <div class="col-md-4 mb-3">
                        <div class="display-4 text-success">@Model.ResolvedAlerts</div>
                        <div class="text-muted">Resolved Alerts</div>
                    </div>
                    <div class="col-md-4 mb-3">
                        <div class="display-4 text-warning">@Model.ActiveAlerts</div>
                        <div class="text-muted">Active Alerts</div>
                    </div>
                </div>

                @if (Model.TotalAlerts > 0)
                {
                    <div class="row mt-3">
                        <div class="col-12">
                            <div class="progress">
                                <div class="progress-bar bg-success" role="progressbar"
                                     style="width: @(((double)Model.ResolvedAlerts / Model.TotalAlerts) * 100)%"
                                     aria-valuenow="@Model.ResolvedAlerts"
                                     aria-valuemin="0"
                                     aria-valuemax="@Model.TotalAlerts">
                                    @(Math.Round(((double)Model.ResolvedAlerts / Model.TotalAlerts) * 100, 1))% Resolved
                                </div>
                                <div class="progress-bar bg-warning" role="progressbar"
                                     style="width: @(((double)Model.ActiveAlerts / Model.TotalAlerts) * 100)%"
                                     aria-valuenow="@Model.ActiveAlerts"
                                     aria-valuemin="0"
                                     aria-valuemax="@Model.TotalAlerts">
                                    @(Math.Round(((double)Model.ActiveAlerts / Model.TotalAlerts) * 100, 1))% Active
                                </div>
                            </div>
                            <small class="text-muted mt-2 d-block text-center">
                                Resolution Rate: @(Math.Round(((double)Model.ResolvedAlerts / Model.TotalAlerts) * 100, 1))%
                            </small>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@if (Model.GroupedAlerts.Any())
{
    <div class="row">
        @foreach (var dateGroup in Model.GroupedAlerts)
        {
            <div class="col-12 mb-4">
                <div class="card">
                    <div class="card-header bg-light">
                        <h5 class="card-title mb-0">
                            <i class="bi bi-calendar"></i> @dateGroup.Date.ToString("MMMM dd, yyyy")
                        </h5>
                    </div>
                    <div class="card-body">
                        @if (dateGroup.Alerts.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover">
                                    <thead>
                                        <tr>
                                            <th>Machine</th>
                                            <th>Alert Type</th>
                                            <th>Message</th>
                                            <th>Timestamp</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var alert in dateGroup.Alerts)
                                        {
                                            <tr>
                                                <td><strong>@alert.Machine.Name</strong></td>
                                                <td>
                                                    <span class="badge bg-@(alert.AlertType == "Availability" ? "warning" :
                                                                                                                                 alert.AlertType == "Performance" ? "danger" :
                                                                                                                                 alert.AlertType == "Quality" ? "info" : "secondary")">
                                        @alert.AlertType
                                    </span>
                                </td>
                                <td>@alert.Message</td>
                                <td>@alert.DisplayTimestamp</td>
                                <td>
                                    @if (alert.IsResolved)
                                                    {
                                                        <span class="badge bg-success">Resolved</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-warning">Active</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-3">
                                <i class="bi bi-check-circle" style="font-size: 2rem; color: #28a745;"></i>
                                <p class="text-muted mt-2">No alerts for this date</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="text-center py-5">
        <i class="bi bi-bell-slash" style="font-size: 3rem; color: #ced4da;"></i>
        <h3 class="mt-3">No Alerts Found</h3>
        <p class="text-muted">No alert history available at this time.</p>
        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary">
            <i class="bi bi-speedometer"></i> Back to Dashboard
        </a>
    </div>
}