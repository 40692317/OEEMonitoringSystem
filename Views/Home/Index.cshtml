@{
    ViewData["Title"] = "Home Page";
}

<div class="hero-section">
    <div class="container">
        <h1 class="display-4">OEE Monitoring System</h1>
        <p class="lead">Advanced Overall Equipment Effectiveness monitoring and analysis platform for smart factories</p>

        @if (!User.Identity.IsAuthenticated)
        {
            <div class="mt-4">
                <a class="btn btn-primary btn-lg" asp-controller="Account" asp-action="Login">
                    <i class="bi bi-box-arrow-in-right"></i> Login
                </a>
                <a class="btn btn-outline-light btn-lg" asp-controller="Account" asp-action="Register">
                    <i class="bi bi-person-plus"></i> Register
                </a>
            </div>
        }
        else if (User.IsInRole("Admin"))
        {
            <div class="mt-4">
                <a class="btn btn-primary btn-lg" asp-controller="Admin" asp-action="Index">
                    <i class="bi bi-shield-lock"></i> Admin Panel
                </a>
                <a class="btn btn-outline-light btn-lg" asp-controller="Dashboard" asp-action="PlantDashboard">
                    <i class="bi bi-speedometer"></i> Dashboard
                </a>
            </div>
        }
        else
        {
            <div class="mt-4">
                <a class="btn btn-primary btn-lg" asp-controller="Dashboard" asp-action="PlantDashboard">
                    <i class="bi bi-speedometer"></i> Go to Dashboard
                </a>
                <a class="btn btn-outline-light btn-lg" asp-controller="Machine" asp-action="Index">
                    <i class="bi bi-tools"></i> My Machines
                </a>
            </div>
        }
    </div>
</div>

<div class="container">
    <div class="row">
        <div class="col-md-4 mb-4">
            <div class="card feature-card">
                <i class="bi bi-graph-up"></i>
                <h3>OEE Metrics</h3>
                <p>Monitor Availability, Performance, and Quality metrics in real-time with advanced analytics.</p>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="card feature-card">
                <i class="bi bi-gear-wide-connected"></i>
                <h3>Machine Management</h3>
                <p>Administer machines, configure settings, and assign to operators with ease.</p>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="card feature-card">
                <i class="bi bi-file-earmark-bar-graph"></i>
                <h3>Advanced Reporting</h3>
                <p>Generate detailed reports, export data, and analyze historical trends.</p>
            </div>
        </div>
    </div>
</div>