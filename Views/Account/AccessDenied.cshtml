@{
    ViewData["Title"] = "Access Denied";
}

<div class="d-flex flex-column align-items-center justify-content-center text-center" style="min-height:80vh;">
    <!-- Big Icon -->
    <div class="mb-4">
        <i class="bi bi-shield-lock text-danger" style="font-size: 6rem;"></i>
    </div>

    <!-- Title -->
    <h1 class="text-danger fw-bold">Access Denied</h1>
    <p class="text-muted fs-5 mb-4">
        Sorry, you don’t have permission to view this page.
    </p>

    <!-- Extra info -->
    <div class="alert alert-warning shadow-sm w-50">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        If you believe this is an error, please contact your administrator.
    </div>

    <!-- Buttons -->
    <div class="mt-4">
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg me-2">
            <i class="bi bi-house-door"></i> Go Home
        </a>

        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
            <button type="submit" class="btn btn-outline-danger btn-lg">
                <i class="bi bi-box-arrow-right"></i> Logout
            </button>
        </form>
    </div>

</div>
