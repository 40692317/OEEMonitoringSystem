@{
    ViewData["Title"] = "Plant Dashboard";
}

<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="mb-0">
                    <i class="bi bi-building"></i> Plant Dashboard
                </h1>
                <p class="text-muted mb-0">Overall equipment effectiveness across all machines</p>
            </div>
            <div>
                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Back to Main Dashboard
                </a>
            </div>
        </div>
    </div>
</div>




<!-- Plant-wide Statistics -->
<div class="row mb-4">
    <div class="col-md-3 mb-3">
        <div class="card text-center h-100">
            <div class="card-body">
                <div class="display-4 text-primary">@((ViewBag.Machines as IEnumerable<dynamic>)?.Count() ?? 0)</div>
                <div class="text-muted">Total Machines</div>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card text-center h-100">
            <div class="card-body">
                <div class="display-4 text-success">@((ViewBag.ActiveAlerts as IEnumerable<dynamic>)?.Count() ?? 0)</div>
                <div class="text-muted">Active Alerts</div>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card text-center h-100">
            <div class="card-body">
                <div class="display-4 text-info">
                    @if (ViewBag.LatestOEECalculations != null && ((Dictionary<int, OEEMonitoringSystem.Models.OEECalculation>)ViewBag.LatestOEECalculations).Any())
                    {
                        var avgOEE = ((Dictionary<int, OEEMonitoringSystem.Models.OEECalculation>)ViewBag.LatestOEECalculations)
                        .Values.Average(o => o.OEE);
                        @Math.Round(avgOEE, 2)
                    }
                    else
                    {
                        @:0
                                        }
                </div>
                <div class="text-muted">Avg OEE</div>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card text-center h-100">
            <div class="card-body">
                <div class="display-4 text-warning">
                    @if (ViewBag.LatestOEECalculations != null && ((Dictionary<int, OEEMonitoringSystem.Models.OEECalculation>)ViewBag.LatestOEECalculations).Any())
                    {
                        var avgAvailability = ((Dictionary<int, OEEMonitoringSystem.Models.OEECalculation>)ViewBag.LatestOEECalculations)
                        .Values.Average(o => o.Availability);
                        @Math.Round(avgAvailability, 2)
                    }
                    else
                    {
                        @:0
                                        }
                </div>
                <div class="text-muted">Avg Availability</div>
            </div>
        </div>
    </div>
</div>

<!-- Machine Grid -->
@if (ViewBag.Machines != null && ((List<OEEMonitoringSystem.Models.Machine>)ViewBag.Machines).Any())
{
    <div class="row">
        @foreach (var machine in (List<OEEMonitoringSystem.Models.Machine>)ViewBag.Machines)
        {
            var oee = ViewBag.LatestOEECalculations != null && ((Dictionary<int, OEEMonitoringSystem.Models.OEECalculation>)ViewBag.LatestOEECalculations).ContainsKey(machine.Id)
            ? ((Dictionary<int, OEEMonitoringSystem.Models.OEECalculation>)ViewBag.LatestOEECalculations)[machine.Id]
            : null;
            var state = ViewBag.MachineStates != null && ((Dictionary<int, OEEMonitoringSystem.Models.Enums.MachineState>)ViewBag.MachineStates).ContainsKey(machine.Id)
                ? ((Dictionary<int, OEEMonitoringSystem.Models.Enums.MachineState>)ViewBag.MachineStates)[machine.Id]
                : OEEMonitoringSystem.Models.Enums.MachineState.Normal;
            var stateBadgeClass = state == OEEMonitoringSystem.Models.Enums.MachineState.Critical ? "bg-danger" : state == OEEMonitoringSystem.Models.Enums.MachineState.Warning ? "bg-warning text-dark" : "bg-success";
            var stateText = state.ToString();
            var predOEE = ViewBag.PredictedOEE != null && ((Dictionary<int, float?>)ViewBag.PredictedOEE).ContainsKey(machine.Id)
                ? ((Dictionary<int, float?>)ViewBag.PredictedOEE)[machine.Id]
                : (float?)null;

            <div class="col-md-6 col-lg-4 mb-4" data-machine-id="@machine.Id">
                <div class="card dashboard-card h-100">
                    <div class="card-header">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5 class="card-title mb-0">@machine.Name</h5>
                            <div>
                                <span class="badge @stateBadgeClass me-1" data-role="machine-state" title="ML classification: Normal / Warning / Critical">@stateText</span>
                                <span class="badge @(machine.IsActive ? "bg-success" : "bg-secondary")">
                                    @(machine.IsActive ? "Active" : "Inactive")
                                </span>
                            </div>
                        </div>
                        <small class="text-white-50">@machine.Location</small>
                    </div>
                    <div class="card-body">
                        @if (oee != null)
                        {
                            <div class="text-center mb-3">
                                <div class="oee-percentage">@oee.OEE%</div>
                                <div class="small text-muted">Overall OEE</div>
                            </div>

                            <div class="progress mb-3">
                                <div class="progress-bar" role="progressbar" style="width: @(oee.OEE)%;" aria-valuenow="@oee.OEE" aria-valuemin="0" aria-valuemax="100">
                                    @oee.OEE%
                                </div>
                            </div>

                            <div class="row text-center small">
                                <div class="col-4">
                                    <div class="fw-bold" data-metric="availability">@oee.Availability</div>
                                    <div class="text-muted">Availability</div>
                                </div>
                                <div class="col-4">
                                    <div class="fw-bold" data-metric="performance">@oee.Performance</div>
                                    <div class="text-muted">Performance</div>
                                </div>
                                <div class="col-4">
                                    <div class="fw-bold" data-metric="quality">@oee.Quality</div>
                                    <div class="text-muted">Quality</div>
                                </div>
                            </div>
                            <div class="small text-info mt-2 border-top pt-2" data-role="predicted-oee" style="@(predOEE.HasValue ? "" : "display:none;")">
                                @if (predOEE.HasValue)
                                {
                                    <i class="bi bi-graph-up-arrow"></i> <text>Predicted OEE (ML): </text>@(predOEE.Value.ToString("F1"))<text>%</text>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-4">
                                <div class="text-muted">No data available</div>
                                <small class="text-muted">Generate events to calculate OEE</small>
                            </div>
                        }
                    </div>
                    <div class="card-footer">
                        <a asp-controller="Dashboard" asp-action="MachineDetail" asp-route-id="@machine.Id" class="btn btn-outline-primary btn-sm w-100">
                            <i class="bi bi-eye"></i> Details
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="text-center py-5">
        <i class="bi bi-tools" style="font-size: 3rem; color: #ced4da;"></i>
        <h3 class="mt-3">No Machines Available</h3>
        <p class="text-muted">Contact your administrator to assign machines to your account.</p>
        @if (ViewBag.IsAdmin != null && (bool)ViewBag.IsAdmin)
        {
            <a asp-controller="Admin" asp-action="Machines" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Manage Machines
            </a>
        }
    </div>
}
@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script src="~/js/dashboard.js"></script>
}
