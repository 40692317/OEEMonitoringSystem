@{
    ViewData["Title"] = "Charts Dashboard";
    var machines = ViewBag.Machines as List<OEEMonitoringSystem.Models.Machine>;
    var selectedMachineId = ViewBag.SelectedMachineId as int?;
    var selectedDays = (int)(ViewBag.SelectedDays ?? 14);
    var chartData = ViewBag.ChartData as OEEMonitoringSystem.Models.ViewModels.ChartDataViewModel;
    var hasData = chartData?.OEEData != null && chartData.OEEData.Count > 0;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-0"><i class="bi bi-graph-up"></i> Analytics Dashboard</h1>
        <p class="text-muted mb-0">OEE trend analysis with Availability, Performance &amp; Quality breakdown</p>
    </div>
    <a asp-controller="Dashboard" asp-action="PlantDashboard" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Back to Plant Dashboard
    </a>
</div>

<div class="card mb-4">
    <div class="card-body py-3">
        <form method="get" asp-action="ChartDashboard" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label for="machineSelect" class="form-label fw-semibold">Machine</label>
                <select id="machineSelect" name="machineId" class="form-select">
                    @if (machines != null)
                    {
                        @foreach (var machine in machines)
                        {
                            <option value="@machine.Id" selected="@(machine.Id == selectedMachineId ? "selected" : null)">
                                @machine.Name — @machine.Location
                            </option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label for="daysSelect" class="form-label fw-semibold">Time Range</label>
                <select id="daysSelect" name="days" class="form-select">
                    <option value="7" selected="@(selectedDays == 7 ? "selected" : null)">Last 7 Days</option>
                    <option value="14" selected="@(selectedDays == 14 ? "selected" : null)">Last 14 Days</option>
                    <option value="30" selected="@(selectedDays == 30 ? "selected" : null)">Last 30 Days</option>
                    <option value="60" selected="@(selectedDays == 60 ? "selected" : null)">Last 60 Days</option>
                    <option value="90" selected="@(selectedDays == 90 ? "selected" : null)">Last 90 Days</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-funnel"></i> Apply
                </button>
            </div>
        </form>
    </div>
</div>

@if (hasData)
{
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-center border-0" style="background: linear-gradient(135deg, #3498db, #2980b9); color: white;">
                <div class="card-body py-3">
                    <div class="h2 mb-0">@(chartData.OEEData.Any() ? chartData.OEEData.Last().ToString("F1") : "0.0")%</div>
                    <small class="opacity-75">Latest OEE</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center border-0" style="background: linear-gradient(135deg, #27ae60, #219653); color: white;">
                <div class="card-body py-3">
                    <div class="h2 mb-0">@(chartData.AvailabilityData.Any() ? chartData.AvailabilityData.Last().ToString("F1") : "0.0")%</div>
                    <small class="opacity-75">Latest Availability</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center border-0" style="background: linear-gradient(135deg, #f39c12, #d35400); color: white;">
                <div class="card-body py-3">
                    <div class="h2 mb-0">@(chartData.PerformanceData.Any() ? chartData.PerformanceData.Last().ToString("F1") : "0.0")%</div>
                    <small class="opacity-75">Latest Performance</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center border-0" style="background: linear-gradient(135deg, #8e44ad, #7d3c98); color: white;">
                <div class="card-body py-3">
                    <div class="h2 mb-0">@(chartData.QualityData.Any() ? chartData.QualityData.Last().ToString("F1") : "0.0")%</div>
                    <small class="opacity-75">Latest Quality</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Row 1: OEE Trend + A/P/Q Breakdown -->
    <div class="row">
        <div class="col-lg-8 mb-4">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0"><i class="bi bi-graph-up"></i> OEE Trend with A / P / Q</h5>
                    <span class="badge bg-light text-dark">@chartData.OEEData.Count data points</span>
                </div>
                <div class="card-body">
                    <div class="chart-container">
                        <canvas id="oeeTrendChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-4 mb-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0"><i class="bi bi-pie-chart"></i> Average A / P / Q Split</h5>
                </div>
                <div class="card-body">
                    <div class="chart-container">
                        <canvas id="apqRadarChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Row 2: Throughput + Downtime -->
    <div class="row">
        <div class="col-lg-6 mb-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0"><i class="bi bi-bar-chart"></i> Daily Production Throughput</h5>
                </div>
                <div class="card-body">
                    <div class="chart-container">
                        <canvas id="throughputChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-6 mb-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0"><i class="bi bi-clock-history"></i> Downtime &amp; Defects</h5>
                </div>
                <div class="card-body">
                    <div class="chart-container">
                        <canvas id="downtimeChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Row 3: A/P/Q Stacked Bar -->
    <div class="row">
        <div class="col-12 mb-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0"><i class="bi bi-layers"></i> Availability / Performance / Quality — Daily Comparison</h5>
                </div>
                <div class="card-body">
                    <div class="chart-container">
                        <canvas id="apqBarChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="card-body text-center py-5">
            <i class="bi bi-bar-chart-line" style="font-size: 4rem; color: #ced4da;"></i>
            <h3 class="mt-3 text-muted">No Chart Data Available</h3>
            <p class="text-muted">Select a machine and ensure events have been generated to see analytics.</p>
        </div>
    </div>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>

    @if (hasData)
    {
        <script>
            window.__chartData = {
                labels:          @Html.Raw(Json.Serialize(chartData.Labels)),
                oee:             @Html.Raw(Json.Serialize(chartData.OEEData)),
                availability:    @Html.Raw(Json.Serialize(chartData.AvailabilityData)),
                performance:     @Html.Raw(Json.Serialize(chartData.PerformanceData)),
                quality:         @Html.Raw(Json.Serialize(chartData.QualityData)),
                throughput:      @Html.Raw(Json.Serialize(chartData.ThroughputData)),
                downtime:        @Html.Raw(Json.Serialize(chartData.DowntimeData)),
                defects:         @Html.Raw(Json.Serialize(chartData.DefectData))
            };
        </script>
    }

    <script src="~/js/chartDashboard.js" asp-append-version="true"></script>
}
