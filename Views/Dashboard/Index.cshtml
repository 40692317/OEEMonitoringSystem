@{
    ViewData["Title"] = "Dashboard";
    // Cast ViewBag.Machines to List<Machine> to avoid dynamic dispatch
    var machines = ViewBag.Machines as List<OEEMonitoringSystem.Models.Machine>;
    var users = ViewBag.Users as List<OEEMonitoringSystem.Models.ApplicationUser>;
}

<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="mb-0">
                    <i class="bi bi-speedometer2"></i> Dashboard
                </h1>
                <p class="text-muted mb-0">Main dashboard with quick access to all views</p>
            </div>
            
        </div>
    </div>
</div>

<!-- Quick Access Cards -->
<div class="row mb-4">
    <div class="col-md-6 mb-3">
        <div class="card text-center h-100">
            <div class="card-body">
                <i class="bi bi-building display-4 text-primary mb-3"></i>
                <h5 class="card-title">Plant Dashboard</h5>
                <p class="card-text">Overall equipment effectiveness across all machines</p>
                <a asp-controller="Dashboard" asp-action="PlantDashboard" class="btn btn-primary">
                    <i class="bi bi-arrow-right"></i> View Plant Dashboard
                </a>
            </div>
        </div>
    </div>
    <div class="col-md-6 mb-3">
        <div class="card text-center h-100">
            <div class="card-body">
                <i class="bi bi-graph-up display-4 text-success mb-3"></i>
                <h5 class="card-title">Charts Dashboard</h5>
                <p class="card-text">Data visualization and trend analysis</p>
                <a asp-controller="Dashboard" asp-action="ChartDashboard" class="btn btn-success">
                    <i class="bi bi-arrow-right"></i> View Charts Dashboard
                </a>
            </div>
        </div>
    </div>
</div>


